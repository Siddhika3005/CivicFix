# =========================
# OS & IDE Files
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# =========================
# Environment Variables
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# =========================
# Frontend (Next.js / Node)
# =========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next-PWA generated files (Prevents committing auto-generated service workers)
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map
frontend/public/fallback-*.js

# Vercel specific
.vercel

# =========================
# Backend (Python / FastAPI)
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
backend/.venv/
backend/venv/
backend/env/
*.venv

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and databases
*.log
*.sqlite3
